# Entries for the Secrets of ESPHome Device Builder (Secrets button, top
# right). Never publish your secrets.yaml with the real values.

# Home Wi-Fi, 2.4 GHz only: the ESP32 can't see 5 GHz networks.
# ESPHome Device Builder usually adds these two for you with the first device.
wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Encryption key for the API and OTA updates: 32 random bytes in base64.
# Generate one with:  openssl rand -base64 32
# or with the generator on https://esphome.io/components/api/
# Home Assistant asks for it when you add the device.
helty_api_key: "paste-the-generated-key-here"

# Password of the fallback hotspot, at least 8 characters
helty_ap_password: "choose-a-long-password"
